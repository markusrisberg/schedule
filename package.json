{
  "name": "schedule-2026",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "10.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "parse": "tsx ./bin/parse.ts",
    "test": "node --import tsx --test ./test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.web.json",
    "holidays:se": "holidays2json --pick SE --min",
    "dev": "pnpm holidays:se && vite",
    "build:web": "pnpm holidays:se && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "date-holidays": "3.26.2"
  },
  "devDependencies": {
    "@types/node": "25.5.2",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vite": "8.3.1"
  }
}
